# DATA-AI .gitignore

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 虚拟环境 ─────────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── IDE ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ── Jupyter Notebook ──────────────────────────────────────────────────
.ipynb_checkpoints

# ── pytest ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── mypy ──────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── ruff ──────────────────────────────────────────────────────────────
.ruff_cache/

# ── 敏感配置文件 ──────────────────────────────────────────────────────
# 用户配置文件（包含 API 密钥）
config/config.toml
config/config.json
config/*.local.toml
config/*.local.json

# 环境变量文件
.env
.env.*
*.env

# ── 数据目录 ──────────────────────────────────────────────────────────
# 用户数据
data/memory/
data/sessions/
data/cache/
data/logs/
data/vector*/

# 本地存储
.storage/
.local/

# ── 日志文件 ──────────────────────────────────────────────────────────
logs/
*.log

# ── 缓存 ──────────────────────────────────────────────────────────────
.cache/
*.cache

# ── 操作系统 ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── 构建产物 ──────────────────────────────────────────────────────────
*.pyc
*.pyo
*.exe
*.dll
*.so
*.dylib

# ── 打包文件 ──────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ── 临时文件 ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.orig

# ── 备份目录 ──────────────────────────────────────────────────────────
backup/

# ── 前端构建产物 ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ── IDE 内部工作区（不能 commit） ───────────────────────────────────
.trae/

# ── Docker ────────────────────────────────────────────────────────────
.docker/

# ── 项目特定排除 ──────────────────────────────────────────────────────
# 排除 app/ 目录（旧代码，已迁移到 src/）
app/

# 排除旧的备份文件
*.original
*.old

# 排除测试输出
test_output/
test_results/

# 排除敏感的 schema 文件中的示例 token
# (保留文件，但确保示例 token 是占位符格式)
