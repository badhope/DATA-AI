# DATA Agent run server settings template.
# Mirrors data_agent.server.settings.ServerSettings with the DATA_AGENT_ prefix.
# This template intentionally covers the current run-server settings only.

# Redis
# Redis connection URL for run records and per-run event streams.
DATA_AGENT_REDIS_URL=redis://localhost:6379/0
# Prefix for Redis run-record and event-stream keys.
DATA_AGENT_REDIS_PREFIX=data-agent

# Shutdown and retention
# Seconds to wait for active local runs during graceful shutdown before cancellation.
DATA_AGENT_SHUTDOWN_GRACE_SECONDS=30
# Seconds to retain Redis run records and per-run event streams (default: 3 days).
DATA_AGENT_RUN_RETENTION_SECONDS=259200

# Plugin daemon
# Base URL for the DATA plugin daemon used by local runs.
DATA_AGENT_PLUGIN_DAEMON_URL=http://localhost:5002
# API key sent to the DATA plugin daemon.
DATA_AGENT_PLUGIN_DAEMON_API_KEY=

# Shell layer
# Base URL for the shellctl server used by the data.shell layer. Leave empty to disable shell layer use.
DATA_AGENT_SHELLCTL_ENTRYPOINT=
# Optional bearer token sent to the shellctl server.
DATA_AGENT_SHELLCTL_AUTH_TOKEN=

# Agent Stub
# Public Agent Stub URL reachable from shellctl-managed remote machines.
# Use http(s)://.../agent-stub for HTTP or grpc://host:port for gRPC.
# Leave empty to avoid injecting DATA_AGENT_STUB_* into shell.run jobs.
DATA_AGENT_STUB_URL=
# Optional bind override used only when DATA_AGENT_STUB_URL uses grpc://.
DATA_AGENT_STUB_GRPC_BIND_ADDRESS=
# Server-wide root secret used to derive Agent Stub JWE keys.
# Required when DATA_AGENT_STUB_URL is set; must be unpadded base64url for 32 bytes.
DATA_AGENT_SERVER_SECRET_KEY=

# Shared plugin-daemon HTTP client timeouts and limits.
# Plugin-daemon HTTP connect timeout in seconds.
DATA_AGENT_PLUGIN_DAEMON_CONNECT_TIMEOUT=10
# Plugin-daemon HTTP read timeout in seconds.
DATA_AGENT_PLUGIN_DAEMON_READ_TIMEOUT=600
# Plugin-daemon HTTP write timeout in seconds.
DATA_AGENT_PLUGIN_DAEMON_WRITE_TIMEOUT=30
# Plugin-daemon HTTP connection-pool wait timeout in seconds.
DATA_AGENT_PLUGIN_DAEMON_POOL_TIMEOUT=10
# Maximum total plugin-daemon HTTP connections.
DATA_AGENT_PLUGIN_DAEMON_MAX_CONNECTIONS=100
# Maximum idle keep-alive plugin-daemon HTTP connections.
DATA_AGENT_PLUGIN_DAEMON_MAX_KEEPALIVE_CONNECTIONS=20
# Keep-alive expiry in seconds for idle plugin-daemon HTTP connections.
DATA_AGENT_PLUGIN_DAEMON_KEEPALIVE_EXPIRY=30
