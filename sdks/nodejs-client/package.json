{
  "name": "@data-ai/sdk",
  "version": "3.1.0",
  "description": "Typed client for the DATA-AI HTTP API. Chat, completion, workflow, knowledge base — all the things you'd want to script.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "DATA",
    "DATA.AI",
    "LLM",
    "AI",
    "SDK",
    "API"
  ],
  "author": "LangGenius",
  "contributors": [
    "Joel <iamjoel007@gmail.com> (https://github.com/iamjoel)",
    "lyzno1 <yuanyouhuilyz@gmail.com> (https://github.com/lyzno1)",
    "crazywoola <427733928@qq.com> (https://github.com/crazywoola)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/langgenius/data.git",
    "directory": "sdks/nodejs-client"
  },
  "bugs": {
    "url": "https://github.com/langgenius/data/issues"
  },
  "homepage": "https://data.ai",
  "license": "MIT",
  "scripts": {
    "build": "vp pack",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsgo",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "publish:check": "./scripts/publish.sh --dry-run",
    "publish:npm": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@data/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
